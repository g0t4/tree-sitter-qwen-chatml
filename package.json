{
  "name": "tree-sitter-qwen-chatml",
  "version": "0.1.0",
  "description": "Parser for raw prompts and completions when working with Qwen models.",
  "homepage": "https://github.com/g0t4/tree-sitter-qwen_chatml#readme",
  "bugs": {
    "url": "https://github.com/g0t4/tree-sitter-qwen_chatml/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g0t4/tree-sitter-qwen_chatml.git"
  },
  "license": "MIT",
  "author": {
    "name": "Wes Higbee"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "qwen_chatml"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.26.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js",
    "test_corpus": "./scripts/tests.fish",
    "build": "./scripts/build.fish"
  }
}
