==================
prompt (file-level FIM)
:language(qwen_chatml)
==================
<|fim_prefix|>local M = {}

function M.add(a, b)
    return a + b
end

function M.sub(a, b)
    return b
end

<|fim_suffix|>

return M<|fim_middle|>
---
(source_file
  (fim_file_level
    (fim_prefix_token)
    prefix: (text)
    (fim_suffix_token)
    suffix: (text)
    (fim_middle_token)))
