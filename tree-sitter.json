{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "qwen_chatml",
      "camelcase": "QwenChatML",
      "title": "Qwen ChatML",
      "scope": "source.qwen_chatml",
      "file-types": [
        "qwen_chatml"
      ],
      "injection-regex": "^qwen_chatml$",
      "class-name": "TreeSitterQwenChatml"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Parser for raw prompts and completions when working with Qwen models.",
    "authors": [
      {
        "name": "Wes Higbee"
      }
    ],
    "links": {
      "repository": "https://github.com/g0t4/tree-sitter-qwen_chatml",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
